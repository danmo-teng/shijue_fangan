+def export_native_replay(session,output,result):
+    session=Path(session).resolve();output=Path(output).resolve()
+    if output==session or session in output.parents or output in session.parents:
+        raise ValueError('Output must be outside original session and ancestors')
+    names=('native_replay.json','trajectory.csv','wall_corrections.csv','source_events.jsonl')
+    paths=[output/name for name in names]
+    if any(path.exists() for path in paths):raise FileExistsError('Native replay output exists: '+str(output))
+    output.mkdir(parents=True,exist_ok=True)
+    with paths[0].open('x') as stream:json.dump(result[0],stream,ensure_ascii=False,indent=2,allow_nan=False);stream.write('\n')
+    for path,rows in zip(paths[1:3],result[1:3]):
+        with path.open('x',newline='') as stream:
+            fields=sorted({key for row in rows for key in row})
+            if fields:
+                writer=csv.DictWriter(stream,fieldnames=fields,lineterminator='\n');writer.writeheader();writer.writerows(rows)
