+        protocol_major=1,protocol_minor=3,drift_bound_ppm=0xffffffff)
+    # Already matched, exact-offset clock context is a software fixture. Unknown
+    # physical timing quality stays unknown and is never promoted to calibrated.
+    context=dict(kind='clock_context',sample=dict(identity=identity,syncs=[dict(
+        lower=0,upper=0,host_ns=t0,nonce=1,boot_epoch=epoch.hex())]))
+
+    def gyro(yaw_id,rate_id,t,yaw_mdeg,rate_mdps=90000,*,rate_t=None,receive_t=None):
+        rate_t=t if rate_t is None else rate_t
+        sample=wire.decode(wire.packet(wire.GYRO,yaw_id,struct.pack(
+            '>16sIIqQIIIiQIIIQ',epoch,1,yaw_id,yaw_mdeg,t//1000,yaw_id,1,
+            0xffffffff,rate_mdps,rate_t//1000,rate_id,1,0xffffffff,rate_t//1000+100)))
+        sample['receive_monotonic_ns']=t+late_rx_ns if receive_t is None else receive_t
+        return sample
+
+    def wheel(runtime,index,start,end,count):
+        # Actual F405 kinematics: opposing first/second wheel deltas produce
+        # forward speed. No command target or SDK velocity supplies this input.
+        speed=math.pi*.070/1061.268*(2*count)/(math.sqrt(3)*((end-start)/1e9))
+        sample=wire.decode(wire.packet(wire.WHEEL,index,struct.pack(
+            '>16sIIQQiiIIIiiiIII',epoch,1,index,start//1000,end//1000,
+            round(speed*1e6),0,100,100,100,count,-count,0,129,0xffffffff,3)))
+        sample['receive_monotonic_ns']=end+late_rx_ns
+        runtime.command('context',dict(kind='timed_wheel_diagnostic',sample=sample))
+
+    with tempfile.TemporaryDirectory() as temporary:
+        for phase_ms in (0.,28.):
+            log_root=Path(temporary)/str(phase_ms);log_root.mkdir()
+            configuration=dict(session_id='phase-runtime-'+str(phase_ms),feedback_fd=-1,pose_fd=-1,
+                robust_odometry_enabled=True,log_root=str(log_root))
+            if phase_ms:configuration['primary_yaw_phase_ms']=phase_ms
+            runtime=NativeMotionRuntime(configuration)
+            try:
+                if not phase_ms:
+                    # The unconfigured default retains legacy primary-yaw input
+                    # and its original schema, without a claimed phase alignment.
+                    runtime.command('context',dict(kind='imu',sample=dict(wire_valid=True,
+                        timestamp_monotonic_ns=t0-100_000_000,yaw_deg=5.)))
+                    legacy=runtime.snapshot(dict(kind='histories'))
+                    assert legacy['last_yaw_source']['source']=='legacy_primary_yaw_receive'
+                    assert legacy['yaws'][0][0]==t0-100_000_000
+                    assert abs(legacy['yaws'][0][1]-math.radians(5.))<1e-14
+                    assert not {'primary_yaw_alignment','raw_yaws','raw_first_yaw','raw_last_yaw'} & legacy.keys()
+                    runtime.command('invalidate',dict(reason='software fixture reset',revision=0))
+                runtime.command('context',context)
+                first=gyro(11,101,t0,0)
+                # Both Python forwarding and native protocol context are used in
+                # production; preserve the full independent source identities.
+                runtime.command('yaw',dict(time_ns=t0,yaw_deg=0.,
+                    source=dict(source='versioned_primary_yaw',raw=first)))
+                wheel(runtime,1,t0-10_000_000,t0,0)
+                bound=runtime.command('known_reference',dict(center_xy_m=[.2,-.3],yaw_deg=42.,
+                    description='assumed software fixture placement; no physical accuracy proof',
+                    reference_kind='assumed'))['reference']
+                assert bound['reference_kind']=='assumed' and not bound['physical_placement_confirmed']
+                assert runtime.snapshot()['last']['center_xy_m']==[.2,-.3]
+                runtime.command('context',dict(kind='timed_gyro_diagnostic',sample=gyro(12,102,t1,9000)))
+                wheel(runtime,2,t0,t1,10)
+                state=runtime.snapshot(dict(kind='histories'))
+                raw=[[t0,0.],[t1,math.radians(9.)]]
+                assert state['poses']==[] and state['pose_ingested']==0 and not state['sdk_available']
+                assert state['last']['ready'] and state['motion_selection']['mode']=='WHEEL_ONLY_NO_SDK'
+                assert state['last']['t265_center_xy_m'] is None
+                assert state['reference']==bound and state['error'] is None
+                assert math.dist(state['last']['center_xy_m'],[.2,-.3])>1e-4
+                assert abs(state['last']['yaw_deg']-51.)<1e-9
+                if phase_ms:
+                    assert [row[0] for row in state['raw_yaws']]==[row[0] for row in raw]
+                    assert max(abs(a[1]-b[1]) for a,b in zip(state['raw_yaws'],raw))<1e-14
+                    assert state['raw_first_yaw']==state['raw_yaws'][0] and state['raw_last_yaw']==state['raw_yaws'][-1]
+                    assert [row[0] for row in state['yaws'][:2]]==[t0-phase_ns,t1-phase_ns]
+                    assert abs(state['yaws'][1][1]-math.radians(9.))<1e-14
+                    assert state['yaws'][-1][0]==t1
+                    assert abs(state['yaws'][-1][1]-math.radians(11.52))<1e-12
+                    alignment=state['last']['primary_yaw_alignment']
+                    assert alignment['support']=='finite_rate_prediction'
+                    assert alignment['yaw_source_id']==12 and alignment['rate_source_id']==102
+                    assert alignment['original_yaw_event_ns']==t1 and alignment['prediction_until_ns']==t1
+                    assert alignment['prediction_endpoint']=='source_event' and not alignment['physical_delay_calibrated']
+                    assert alignment['SDK_input_pairing_unchanged'] and not alignment['added_wait']
+                else:
+                    assert [row[0] for row in state['yaws']]==[row[0] for row in raw]
+                    assert max(abs(a[1]-b[1]) for a,b in zip(state['yaws'],raw))<1e-14
+                    assert 'primary_yaw_alignment' not in state and 'raw_yaws' not in state
+                    assert 'primary_yaw_alignment' not in state['last']
+                geometry=runtime.snapshot(dict(kind='window',geometry_only=True,
+                    first_ns=t0-phase_ns,last_ns=t1))
+                assert geometry['yaws']==state['yaws'] and geometry['reference']==bound
+                before=state['yaws'];ingested=state['primary_yaw_ingested']
+                # A later independently numbered rate, carried with the same
+                # yaw ID, cannot revise or extend that older yaw's prediction.
+                rate_only=gyro(12,103,t1,9000,rate_mdps=900000,rate_t=t1+50_000_000,
+                    receive_t=t1+late_rx_ns+50_000_000)
+                for _ in range(2):
+                    runtime.command('context',dict(kind='timed_gyro_diagnostic',sample=rate_only))
+                repeated=runtime.snapshot(dict(kind='histories'))
+                assert repeated['yaws']==before and repeated['primary_yaw_ingested']==ingested
+                if phase_ms:assert repeated['raw_yaws']==state['raw_yaws']
+                wheel(runtime,3,t1,t1+10_000_000,1)
+                later=runtime.snapshot()
+                assert abs(later['last']['yaw_deg']-51.)<1e-9
+                assert later['last']['sample_monotonic_ns']==t1+10_000_000
+                assert later['reference']==bound and later['last']['ready']
+                if phase_ms:
+                    held=later['last']['primary_yaw_alignment']
+                    assert held['support']=='endpoint_hold' and held['prediction_until_ns']==t1
+                    assert held['yaw_source_id']==12 and held['rate_source_id']==102
+                    assert later['last_yaw_source']['raw']['receive_monotonic_ns']==t1+late_rx_ns
+                    assert abs(later['last_yaw'][1]-math.radians(11.52))<1e-12
+                # Same real 07/08 contexts also feed the experimental angular
+                # comparison, independently of control/SDK input admission.
+                runtime.command('context',dict(kind='timed_gyro_diagnostic',
+                    sample=gyro(13,104,t1+50_000_000,13500)))
+                compared=runtime.snapshot()['wheel_yaw_consistency']
+                interval=compared['last_interval'];window=compared['last_window']
+                assert not compared['automatic_slip_decision'] and not compared['controls_sdk_input']
+                assert not compared['translation_slip_observable_from_angle_alone']
+                assert compared['wheel_arm_m']==.130 and compared['primary_yaw_phase_candidate_ms']==phase_ms
+                assert interval['last_wheel_id']==3 and interval['raw_wheel_deltas']==[1,-1,0]
+                assert interval['native_interval_ns']==[t1,t1+10_000_000]
+                assert abs(interval['encoder_delta_rad'])<1e-14
+                assert abs(interval['angular_residual_rad_s']+math.pi/2)<1e-10
+                assert window is not None and window['duration_s']>=.1
+                assert runtime.snapshot()['last']['ready']
+                assert not runtime.snapshot()['motion_selection']['wheel_input_policy']['pause_requested']
+                assert later['error'] is None
+            finally:runtime.close()
diff --git a/localization/include/debug_pose_publisher.hpp b/localization/include/debug_pose_publisher.hpp
new file mode 100644
index 0000000..c4c4b87
--- /dev/null
+++ b/localization/include/debug_pose_publisher.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <json.hpp>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace omni {
+// One SDK owner publishes real Pose packets without queuing old motion. Only
+// the latest explicit SDK state has a bounded retry slot when IPC is full.
+class DebugPosePublisher {
+public:
+    using Json = nlohmann::json;
+    explicit DebugPosePublisher(const std::string &address) {
+        if (address.empty()) return;
+        if (address[0] != '@' || address.size() >= sizeof(address_.sun_path))
+            throw std::invalid_argument("debug pose output requires short @abstract socket");
+        address_.sun_family = AF_UNIX;
+        std::memcpy(address_.sun_path + 1, address.data() + 1, address.size() - 1);
+        size_ = offsetof(sockaddr_un, sun_path) + address.size();
+        fd_ = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        if (fd_ < 0) throw std::runtime_error("cannot create debug pose publisher");
+        const int budget = 262144;
+        ::setsockopt(fd_, SOL_SOCKET, SO_SNDBUF, &budget, sizeof(budget));
+        if (::connect(fd_, reinterpret_cast<const sockaddr *>(&address_), size_) != 0) {
+            ::close(fd_); fd_ = -1;
+            throw std::runtime_error("debug pose receiver unavailable");
+        }
+    }
+    ~DebugPosePublisher() { if (fd_ >= 0) ::close(fd_); }
+
+    void send(const Json &value) {
+        if (fd_ < 0) return;
+        // Never let a fresh Pose overtake an unsent state and then be invalidated
+        // by that older state arriving afterwards. Neither motion nor the SDK
+        // waits for IPC space: this current Pose is simply not queued.
+        if (!flush_pending()) { ++drops_; return; }
+        send_packet(value);
+    }
+    void send_state(const Json &value) {
+        if (fd_ < 0) return;
+        pending_state_ = value;
+        have_pending_state_ = true;
+        flush_pending();
+    }
+    bool flush_pending() {
+        if (!have_pending_state_) return true;
+        if (!send_packet(pending_state_)) return false;
+        have_pending_state_ = false;
+        pending_state_ = nullptr;
+        return true;
+    }
+    bool has_pending_state() const { return have_pending_state_; }
+
+private:
+    bool send_packet(const Json &value) {
+        auto packet = value; packet["ipc_drops"] = drops_;
+        const auto bytes = packet.dump();
+        if (::send(fd_, bytes.data(), bytes.size(), MSG_DONTWAIT | MSG_NOSIGNAL) !=
+                static_cast<ssize_t>(bytes.size())) { ++drops_; return false; }
+        return true;
+    }
+    int fd_ = -1;
+    sockaddr_un address_{};
+    socklen_t size_ = 0;
+    std::uint64_t drops_ = 0;
+    Json pending_state_;
+    bool have_pending_state_ = false;
+};
+} // namespace omni
