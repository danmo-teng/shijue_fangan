+const char *t265_raw_pose_invalid_reason(const T265RawPose &raw) noexcept
+{
+    for (double value : raw.translation_m)
+        if (!std::isfinite(value)) return "nonfinite_translation";
+    for (double value : raw.rotation_xyzw)
+        if (!std::isfinite(value)) return "nonfinite_quaternion";
+    double norm_squared = 0.;
+    for (double value : raw.rotation_xyzw) norm_squared += value * value;
+    if (!std::isfinite(norm_squared)) return "nonfinite_quaternion_norm";
+    if (norm_squared == 0.) return "zero_quaternion_norm";
+    for (double value : raw.velocity_mps)
+        if (!std::isfinite(value)) return "nonfinite_velocity";
+    for (double value : raw.angular_velocity_radps)
+        if (!std::isfinite(value)) return "nonfinite_angular_velocity";
+    if (!std::isfinite(raw.timestamp_s)) return "nonfinite_timestamp";
+    return nullptr;
+}
