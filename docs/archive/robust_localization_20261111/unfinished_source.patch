+void test_wheel_yaw_consistency()
+{
+    using Check = omni::WheelYawConsistency;
+    const std::int64_t origin = 1000000000LL, step = 10000000LL, phase = 28000000LL;
+    auto yaw = [](std::uint32_t id, std::int64_t t, double angle) {
+        Check::YawSample value; value.source_id = id; value.event_ns = t; value.angle_rad = angle; return value;
+    };
+    auto wheel = [](std::uint32_t id, std::int64_t a, std::int64_t b,
+                    std::array<std::int32_t, 3> deltas) {
+        Check::WheelSample value; value.sample_id = id; value.t0_ns = a; value.t1_ns = b;
+        value.deltas = deltas; return value;
+    };
+    {
+        Check::Config config; config.yaw_phase_ns = phase; Check m(config); Check::Result result;
+        m.ingest_yaw(yaw(110, origin + phase, 10.));
+        m.ingest_wheel(wheel(71, origin + step / 2, origin + step * 3 / 2, {{1, 2, 3}}));
+        check(m.pending_samples() == 1 && !m.pop_result(result),
+            "comparison waits only in its own bounded queue for actual yaw endpoint support");
+        check(!m.ingest_yaw(yaw(110, origin + phase + step, 200.)),
+            "a repeated yaw source ID cannot invent historical comparison support");
+        m.ingest_yaw(yaw(117, origin + phase + step * 2, 10.04));
+        check(m.pop_result(result) && result.kind == Check::Kind::Interval && result.first_wheel_id == 71,
+            "real yaw history releases exactly the supported original wheel interval");
+        check(result.t0_ns == origin + step / 2 && result.t1_ns == origin + step * 3 / 2 &&
+              result.yaw_phase_ns == phase && near(result.wheel_arm_m, .130),
+            "comparison keeps original wheel timestamps, explicit phase and deployed arm model");
+        check(result.begin_yaw.interpolated && result.end_yaw.interpolated &&
+              result.begin_yaw.left_source_id == 110 && result.begin_yaw.right_source_id == 117 &&
+              result.end_yaw.left_event_ns == origin + phase &&
+              result.end_yaw.right_event_ns == origin + phase + step * 2,
+            "interpolation exposes independent original yaw IDs and unshifted source events");
+        const double encoder = config.metres_per_count * 6. / (3. * .130);
+        check(near(result.duration_s, .01) && near(result.encoder_delta_rad, encoder) &&
+              near(result.gyro_delta_rad, .02) && near(result.residual_rad_s, (encoder - .02) / .01),
+            "encoder sum and accumulated-yaw difference use exactly the same physical interval");
+        check(!m.pop_result(result), "a partial ten-millisecond block is not reported as a hundred-millisecond window");
+        m.reset();
+        check(m.pending_samples() == 0 && m.yaw_samples() == 0 && !m.pop_result(result),
+            "explicit boot reset removes old yaw, pending intervals, results and window baseline");
+        check(m.ingest_yaw(yaw(1, origin, 0.)), "a new boot can restart source IDs without borrowing old support");
+    }
+    {
+        Check m; Check::Result result;
+        m.ingest_yaw(yaw(1, origin, 0.));
+        m.ingest_yaw(yaw(2, origin + step * 2, .04));
+        m.ingest_wheel(wheel(1, origin, origin + step, {{3, 3, 3}}));
+        check(m.pop_result(result) && result.yaw_phase_ns == 0 && near(result.gyro_delta_rad, .02) &&
+              !result.begin_yaw.interpolated && result.end_yaw.interpolated,
+            "default-zero phase compares original unshifted yaw with exact/interpolated endpoint labels");
+    }
+    {
+        Check m; Check::Result result; std::size_t intervals = 0, windows = 0;
+        for (std::uint32_t i = 0; i <= 10; ++i) {
+            m.ingest_yaw(yaw(100 + i, origin + i * step, 0.));
+            if (i) m.ingest_wheel(wheel(i, origin + (i - 1) * step, origin + i * step, {{3, -3, 0}}));
+        }
+        while (m.pop_result(result)) {
+            if (result.kind == Check::Kind::Interval) { ++intervals; continue; }
+            ++windows;
+            check(result.interval_count == 10 && result.first_wheel_id == 1 && result.last_wheel_id == 10 &&
+                  result.t0_ns == origin && result.t1_ns == origin + 10 * step && near(result.duration_s, .1),
+                "hundred-millisecond window aggregates ten actual contiguous encoder intervals");
+            check(result.deltas[0] == 30 && result.deltas[1] == -30 && near(result.encoder_delta_rad, 0.) &&
+                  near(result.gyro_delta_rad, 0.) && near(result.residual_rad_s, 0.),
+                "nonzero opposing wheel deltas expose the angular residual's pure-translation nullspace");
+        }
+        check(intervals == 10 && windows == 1, "interval and window outputs retain distinct scopes");
+    }
+    {
+        Check m; Check::Result result; std::vector<Check::Result> windows;
+        m.ingest_yaw(yaw(1, origin, 0.)); m.ingest_yaw(yaw(2, origin + 30 * step, 0.));
+        for (std::uint32_t i = 1; i <= 5; ++i)
+            m.ingest_wheel(wheel(i, origin + (i - 1) * step, origin + i * step, {{0, 0, 0}}));
+        // A real interval/ID gap cannot be filled by zero rotation samples.
+        for (std::uint32_t i = 11; i <= 20; ++i)
+            m.ingest_wheel(wheel(i, origin + (i - 5) * step, origin + (i - 4) * step, {{0, 0, 0}}));
+        auto invalid = wheel(21, origin + 16 * step, origin + 17 * step, {{100, 100, 100}});
+        invalid.measurement_valid = false; check(!m.ingest_wheel(invalid), "invalid measured wheel interval is not compared");
+        for (std::uint32_t i = 22; i <= 31; ++i)
+            m.ingest_wheel(wheel(i, origin + (i - 5) * step, origin + (i - 4) * step, {{0, 0, 0}}));
+        while (m.pop_result(result)) if (result.kind == Check::Kind::Window) windows.push_back(result);
+        check(windows.size() == 2 && windows[0].first_wheel_id == 11 && windows[0].last_wheel_id == 20 &&
+              windows[1].first_wheel_id == 22 && windows[1].last_wheel_id == 31 &&
+              windows[0].continuous_block != windows[1].continuous_block && m.statistics().chain_breaks == 2,
+            "missing/invalid intervals start distinct windows without joining pre-gap comparison baselines");
+    }
+    {
+        Check::Config config; config.pending_capacity = 2; config.yaw_capacity = 2; Check m(config); Check::Result result;
+        for (std::uint32_t i = 1; i <= 3; ++i)
+            m.ingest_wheel(wheel(i, origin + (i - 1) * step, origin + i * step, {{1, 1, 1}}));
+        check(m.pending_samples() == 2 && m.statistics().pending_dropped == 1,
+            "missing gyro cannot create an unbounded queue or block wheel/SDK control owners");
+        m.ingest_yaw(yaw(1, origin, 0.)); m.ingest_yaw(yaw(2, origin + 4 * step, 0.));
+        std::size_t count = 0; while (m.pop_result(result)) { ++count; check(result.first_wheel_id >= 2,
+            "a capacity-discarded interval is not reconstructed or replaced with zero motion"); }
+        check(count == 2, "only retained actually bracketed intervals produce comparisons");
+        m.reset();
+        m.ingest_yaw(yaw(1, origin, 0.)); m.ingest_yaw(yaw(2, origin + step, 0.));
+        m.ingest_yaw(yaw(3, origin + 2 * step, 0.));
+        m.ingest_wheel(wheel(1, origin, origin + step, {{1, 1, 1}}));
+        check(m.yaw_samples() == 2 && m.statistics().missing_yaw_bracket == 1 && !m.pop_result(result),
+            "an evicted genuine yaw endpoint cannot be replaced by extrapolated/predicted support");
+    }
+}
