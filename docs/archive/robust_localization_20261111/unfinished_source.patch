+#include "wheel_yaw_consistency.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace omni {
+namespace {
+bool newer(std::uint32_t next, std::uint32_t previous) {
+    const auto step = next - previous;
+    return step > 0 && step < 0x80000000u;
+}
+}
+
+WheelYawConsistency::WheelYawConsistency() : WheelYawConsistency(Config{}) {}
+WheelYawConsistency::WheelYawConsistency(Config configuration) : configuration_(configuration) {
+    if (!std::isfinite(configuration_.metres_per_count) || configuration_.metres_per_count <= 0. ||
+        !std::isfinite(configuration_.wheel_arm_m) || configuration_.wheel_arm_m <= 0. ||
+        configuration_.yaw_phase_ns < 0 || configuration_.window_ns <= 0 ||
+        configuration_.yaw_capacity < 2 || !configuration_.pending_capacity || !configuration_.result_capacity)
+        throw std::invalid_argument("positive wheel geometry, window and bounded capacities required");
+}
+
+void WheelYawConsistency::reset() {
+    yaws_.clear(); pending_.clear(); results_.clear();
+    have_yaw_id_ = have_wheel_ = have_window_ = false;
+    last_yaw_id_ = last_wheel_id_ = 0; last_wheel_end_ = 0;
+    block_ = 0; window_ = Result{}; statistics_ = Statistics{};
+}
+
+bool WheelYawConsistency::ingest_yaw(const YawSample &sample) {
+    if (!std::isfinite(sample.angle_rad) ||
+        sample.event_ns < std::numeric_limits<std::int64_t>::min() + configuration_.yaw_phase_ns) {
+        ++statistics_.invalid_yaw; return false;
+    }
+    if (have_yaw_id_ && !newer(sample.source_id, last_yaw_id_)) {
+        ++statistics_.duplicate_yaw; return false;
+    }
+    if (!yaws_.empty() && sample.event_ns <= yaws_.back().event_ns) {
+        ++statistics_.invalid_yaw; return false;
+    }
+    have_yaw_id_ = true; last_yaw_id_ = sample.source_id;
+    if (yaws_.size() == configuration_.yaw_capacity) { yaws_.pop_front(); ++statistics_.yaw_history_evicted; }
+    yaws_.push_back(sample); process(); return true;
+}
+
+bool WheelYawConsistency::ingest_wheel(const WheelSample &sample) {
+    if (have_wheel_ && !newer(sample.sample_id, last_wheel_id_)) {
+        ++statistics_.duplicate_wheel; return false;
+    }
+    if (!sample.measurement_valid || sample.t1_ns <= sample.t0_ns ||
+        (have_wheel_ && sample.t0_ns < last_wheel_end_)) {
+        ++statistics_.invalid_wheel;
+        if (!sample.measurement_valid) { ++block_; ++statistics_.chain_breaks; have_wheel_ = false; }
+        return false;
+    }
+    if (have_wheel_ && (sample.t0_ns != last_wheel_end_ || sample.sample_id - last_wheel_id_ != 1u)) {
+        ++block_; ++statistics_.chain_breaks;
+    }
+    have_wheel_ = true; last_wheel_id_ = sample.sample_id; last_wheel_end_ = sample.t1_ns;
+    if (pending_.size() == configuration_.pending_capacity) {
+        pending_.pop_front(); ++statistics_.pending_dropped; have_window_ = false;
+    }
+    pending_.push_back(Pending{sample, block_}); process(); return true;
+}
+
+bool WheelYawConsistency::endpoint(std::int64_t time_ns, Endpoint &result) const {
+    if (yaws_.empty()) return false;
+    const auto phase = configuration_.yaw_phase_ns;
+    if (time_ns < yaws_.front().event_ns - phase || time_ns > yaws_.back().event_ns - phase) return false;
+    const auto right = std::lower_bound(yaws_.begin(), yaws_.end(), time_ns,
+        [phase](const YawSample &sample, std::int64_t t) { return sample.event_ns - phase < t; });
+    if (right == yaws_.end()) return false;
+    const auto &a = right->event_ns - phase == time_ns ? *right : *(right - 1);
+    const auto &b = *right;
+    result.support.left_source_id = a.source_id; result.support.right_source_id = b.source_id;
+    result.support.left_event_ns = a.event_ns; result.support.right_event_ns = b.event_ns;
+    result.support.interpolated = a.source_id != b.source_id;
+    if (!result.support.interpolated) result.angle_rad = a.angle_rad;
+    else {
+        const double fraction = (static_cast<double>(time_ns) - static_cast<double>(a.event_ns - phase)) /
+            (static_cast<double>(b.event_ns) - static_cast<double>(a.event_ns));
+        result.angle_rad = a.angle_rad + fraction * (b.angle_rad - a.angle_rad);
+    }
+    return true;
+}
+
+void WheelYawConsistency::emit(const Result &result) {
+    if (results_.size() == configuration_.result_capacity) { results_.pop_front(); ++statistics_.result_dropped; }
+    results_.push_back(result);
+}
+
+void WheelYawConsistency::accumulate(const Result &result) {
+    if (!have_window_ || result.continuous_block != window_.continuous_block || result.t0_ns != window_.t1_ns) {
+        window_ = result; window_.kind = Kind::Window; have_window_ = true;
+    } else {
+        window_.last_wheel_id = result.last_wheel_id; window_.t1_ns = result.t1_ns;
+        window_.interval_count += result.interval_count;
+        for (std::size_t i = 0; i < 3; ++i) window_.deltas[i] += result.deltas[i];
+        window_.encoder_delta_rad += result.encoder_delta_rad; window_.gyro_delta_rad += result.gyro_delta_rad;
+        window_.end_yaw = result.end_yaw;
+    }
+    window_.duration_s = (static_cast<double>(window_.t1_ns) - static_cast<double>(window_.t0_ns)) / 1e9;
+    window_.residual_rad_s = (window_.encoder_delta_rad - window_.gyro_delta_rad) / window_.duration_s;
+    if (static_cast<double>(window_.t1_ns) - static_cast<double>(window_.t0_ns) >= configuration_.window_ns) {
+        emit(window_); have_window_ = false;
+    }
+}
+
+void WheelYawConsistency::process() {
+    while (!pending_.empty() && !yaws_.empty()) {
+        const auto &pending = pending_.front(); const auto &wheel = pending.sample;
+        if (wheel.t1_ns > yaws_.back().event_ns - configuration_.yaw_phase_ns) return;
+        Endpoint a, b;
+        if (!endpoint(wheel.t0_ns, a) || !endpoint(wheel.t1_ns, b)) {
+            pending_.pop_front(); ++statistics_.missing_yaw_bracket; have_window_ = false; continue;
+        }
+        Result result;
+        result.continuous_block = pending.block; result.first_wheel_id = result.last_wheel_id = wheel.sample_id;
+        result.t0_ns = wheel.t0_ns; result.t1_ns = wheel.t1_ns; result.interval_count = 1;
+        result.yaw_phase_ns = configuration_.yaw_phase_ns; result.wheel_arm_m = configuration_.wheel_arm_m;
+        std::int64_t sum = 0;
+        for (std::size_t i = 0; i < 3; ++i) { result.deltas[i] = wheel.deltas[i]; sum += result.deltas[i]; }
+        result.duration_s = (static_cast<double>(wheel.t1_ns) - static_cast<double>(wheel.t0_ns)) / 1e9;
+        result.encoder_delta_rad = configuration_.metres_per_count * static_cast<double>(sum) / (3. * configuration_.wheel_arm_m);
+        result.gyro_delta_rad = b.angle_rad - a.angle_rad;
+        result.residual_rad_s = (result.encoder_delta_rad - result.gyro_delta_rad) / result.duration_s;
+        result.begin_yaw = a.support; result.end_yaw = b.support;
+        pending_.pop_front(); emit(result); accumulate(result);
+    }
+}
+
+bool WheelYawConsistency::pop_result(Result &result) {
+    if (results_.empty()) return false;
+    result = results_.front(); results_.pop_front(); return true;
+}
