+void test_debug_pose_publisher_pending_state()
+{
+    const int server = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    check(server >= 0, "critical Pose state test creates a local software receiver");
+    if (server < 0) return;
+    const std::string name = "@pose-pending-state-" + std::to_string(::getpid());
+    sockaddr_un address{}; address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path + 1, name.data() + 1, name.size() - 1);
+    const auto length = offsetof(sockaddr_un, sun_path) + name.size();
+    if (::bind(server, reinterpret_cast<const sockaddr *>(&address), length) != 0 || ::listen(server, 1) != 0) {
+        check(false, "critical Pose state software receiver binds and listens");
+        ::close(server); return;
+    }
+    {
+        omni::DebugPosePublisher publisher(name);
+        const int peer = ::accept4(server, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+        check(peer >= 0, "critical Pose state sender connects without hardware or ACK");
+        if (peer < 0) { ::close(server); return; }
+        const nlohmann::json filler{{"kind", "filler"}, {"payload", std::string(8192, 'x')}};
+        for (int i = 0; i < 512; ++i) publisher.send(filler);
+        publisher.send_state(nlohmann::json{{"kind", "sdk_availability"}, {"available", false},
+            {"receive_monotonic_ns", 123456}, {"reason", "first pending state"}});
+        check(publisher.has_pending_state(), "full kernel queue retains one explicit state instead of losing it");
+        publisher.send_state(nlohmann::json{{"kind", "sdk_pose_invalid"}, {"frame_number", 37},
+            {"receive_monotonic_ns", 987654}, {"reason", "latest real state"}, {"SDK_pipeline_still_running", true}});
+        check(publisher.has_pending_state(), "new explicit state replaces the one pending slot without waiting");
+        publisher.send(nlohmann::json{{"kind", "pose"}, {"frame_number", -1}});
+        char bytes[16384]; ssize_t count;
+        std::size_t drained = 0;
+        while ((count = ::recv(peer, bytes, sizeof bytes, MSG_DONTWAIT)) > 0) {
+            const auto packet = nlohmann::json::parse(bytes, bytes + count);
+            check(packet.at("kind") == "filler", "a normal Pose cannot overtake the pending explicit state");
+            ++drained;
+        }
+        check(drained > 0 && count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK),
+            "software receiver drains a genuinely full nonblocking kernel queue");
+        check(publisher.flush_pending() && !publisher.has_pending_state(),
+            "existing loop flush delivers the retained state once IPC has space");
+        count = ::recv(peer, bytes, sizeof bytes, MSG_DONTWAIT);
+        check(count > 0, "latest retained state reaches the software receiver");
+        if (count > 0) {
+            const auto packet = nlohmann::json::parse(bytes, bytes + count);
+            check(packet.at("kind") == "sdk_pose_invalid" && packet.at("frame_number") == 37 &&
+                  packet.at("receive_monotonic_ns") == 987654 && packet.at("SDK_pipeline_still_running") == true,
+                "retry preserves the newest real event, original frame and original event time");
+        }
+        publisher.flush_pending();
+        check(::recv(peer, bytes, sizeof bytes, MSG_DONTWAIT) < 0 && (errno == EAGAIN || errno == EWOULDBLOCK),
+            "a delivered state is not repeated and the discarded older state is not replayed");
+        publisher.send(nlohmann::json{{"kind", "pose"}, {"frame_number", 42}});
+        count = ::recv(peer, bytes, sizeof bytes, MSG_DONTWAIT);
+        check(count > 0 && nlohmann::json::parse(bytes, bytes + count).at("frame_number") == 42,
+            "the next actual Pose resumes without replaying any ordinary Pose dropped while full");
+        ::close(peer);
+    }
+    ::close(server);
+}
