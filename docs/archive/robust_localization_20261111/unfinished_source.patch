+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace omni {
+
+// Pure derived view of an already received, unwrapped primary yaw. No clock
+// reads, I/O, wait, age rejection or SDK dependency. The caller owns boot/session
+// identity and explicitly resets this object at that boundary.
+class PrimaryYawTimeline {
+public:
+    enum class PredictionEndpoint { SourceEvent, ReceiveEvent };
+    enum class Support { Unavailable, MeasuredHistory, FinitePrediction, EndpointHold };
+    struct Config {
+        // A phase-model candidate, not a physical sampling-time qualification.
+        std::int64_t phase_ns = 0;
+        std::size_t capacity = 4096;
+        PredictionEndpoint prediction_endpoint = PredictionEndpoint::SourceEvent;
+    };
+    struct YawSample {
+        std::uint32_t source_id = 0;
+        std::int64_t event_ns = 0, receive_ns = 0;
+        double angle_rad = 0.;
+    };
+    struct RateSample {
+        std::uint32_t source_id = 0;
+        std::int64_t event_ns = 0, receive_ns = 0;
+        double omega_rad_s = 0.;
+        // A real independently identified invalid/clipped source publication,
+        // never inferred from age, repetition or absence of another packet.
+        bool usable = true;
+    };
+    struct Estimate {
+        bool available = false;
+        double angle_rad = 0.;
+        Support support = Support::Unavailable;
+        std::int64_t query_ns = 0, phase_ns = 0;
+        std::int64_t measured_until_ns = 0, prediction_until_ns = 0;
+        // Original event stamps and independent IDs remain available. For a
+        // measured interpolation these are the two genuine bounding samples.
+        YawSample left_yaw{}, right_yaw{};
+        bool has_right_yaw = false, uses_rate = false;
+        RateSample rate{};
+    };
+    struct HistoryRow {
+        std::int64_t time_ns = 0;
+        double angle_rad = 0.;
+        Support support = Support::MeasuredHistory;
+        std::uint32_t source_yaw_id = 0, rate_source_id = 0;
+        bool has_rate = false;
+    };
+
+    PrimaryYawTimeline();
+    explicit PrimaryYawTimeline(Config configuration);
+    bool ingest_yaw(const YawSample &sample);
+    bool ingest_rate(const RateSample &sample);
+    Estimate query(std::int64_t time_ns) const;
+    // Low-frequency snapshot only. The optional last row is explicitly an
+    // existing finite prediction endpoint, retaining the same real source IDs.
+    std::vector<HistoryRow> export_history() const;
+    void reset();
+    const Config &configuration() const noexcept { return configuration_; }
+    std::size_t yaw_samples() const noexcept { return yaws_.size(); }
+    std::size_t rate_samples() const noexcept { return rates_.size(); }
+
+private:
+    struct Node {
+        YawSample raw;
+        std::int64_t physical_estimate_ns = 0, prediction_until_ns = 0;
+        double prediction_angle_rad = 0.;
+        bool uses_rate = false;
+        RateSample rate;
+    };
+    Config configuration_;
+    std::deque<Node> yaws_;
+    std::deque<RateSample> rates_;
+    bool have_yaw_id_ = false, have_rate_id_ = false;
+    std::uint32_t last_yaw_id_ = 0, last_rate_id_ = 0;
+};
+
+} // namespace omni
