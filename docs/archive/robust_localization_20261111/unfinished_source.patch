new file mode 100644
index 0000000..b004259
--- /dev/null
+++ b/localization/include/wheel_yaw_consistency.hpp
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+namespace omni {
+
+// A serially-owned interval comparison, never a control/SDK admission policy.
+// All event coordinates are native MCU nanoseconds. Only measured accumulated
+// yaw brackets are interpolated; no current-rate prediction or clock read.
+// Equal angular motion does not exclude translational slip, a common sensor
+// error, or wheel-arm error. Injected SDK Pose is not an independent vote here.
+class WheelYawConsistency {
+public:
+    struct Config {
+        double metres_per_count = 3.14159265358979323846 * .070 / 1061.268;
+        double wheel_arm_m = .130;
+        std::int64_t yaw_phase_ns = 0; // Explicit engineering candidate; raw stamps stay unmodified.
+        std::int64_t window_ns = 100000000;
+        std::size_t yaw_capacity = 4096, pending_capacity = 256, result_capacity = 512;
+    };
+    struct YawSample {
+        std::uint32_t source_id = 0;
+        std::int64_t event_ns = 0;
+        double angle_rad = 0.; // Already unwrapped main yaw, never SDK yaw.
+    };
+    struct WheelSample {
+        std::uint32_t sample_id = 0;
+        std::int64_t t0_ns = 0, t1_ns = 0;
+        std::array<std::int32_t, 3> deltas{{0, 0, 0}};
+        bool measurement_valid = true;
+    };
+    struct YawSupport {
+        std::uint32_t left_source_id = 0, right_source_id = 0;
+        std::int64_t left_event_ns = 0, right_event_ns = 0; // Original, unshifted.
+        bool interpolated = false;
+    };
+    enum class Kind { Interval, Window };
+    struct Result {
+        Kind kind = Kind::Interval;
+        std::uint64_t continuous_block = 0;
+        std::uint32_t first_wheel_id = 0, last_wheel_id = 0;
+        std::size_t interval_count = 0;
+        std::int64_t t0_ns = 0, t1_ns = 0, yaw_phase_ns = 0;
+        std::array<std::int64_t, 3> deltas{{0, 0, 0}};
+        double wheel_arm_m = .130, duration_s = 0.;
+        double encoder_delta_rad = 0., gyro_delta_rad = 0., residual_rad_s = 0.;
+        YawSupport begin_yaw, end_yaw;
+    };
+    struct Statistics {
+        std::uint64_t duplicate_yaw = 0, duplicate_wheel = 0, invalid_yaw = 0, invalid_wheel = 0;
+        std::uint64_t yaw_history_evicted = 0, pending_dropped = 0, result_dropped = 0;
+        std::uint64_t missing_yaw_bracket = 0, chain_breaks = 0;
+    };
+
+    WheelYawConsistency();
+    explicit WheelYawConsistency(Config configuration);
+    bool ingest_yaw(const YawSample &sample);
+    bool ingest_wheel(const WheelSample &sample);
+    bool pop_result(Result &result);
+    // Caller supplies the actual boot/reference boundary; it is not inferred
+    // from arrival age, repeated data or a guessed timeout.
+    void reset();
+    const Config &configuration() const noexcept { return configuration_; }
+    const Statistics &statistics() const noexcept { return statistics_; }
+    std::size_t pending_samples() const noexcept { return pending_.size(); }
+    std::size_t yaw_samples() const noexcept { return yaws_.size(); }
+
+private:
+    struct Pending { WheelSample sample; std::uint64_t block = 0; };
+    struct Endpoint { double angle_rad = 0.; YawSupport support; };
+    Config configuration_; Statistics statistics_;
+    std::deque<YawSample> yaws_; std::deque<Pending> pending_; std::deque<Result> results_;
+    bool have_yaw_id_ = false, have_wheel_ = false, have_window_ = false;
+    std::uint32_t last_yaw_id_ = 0, last_wheel_id_ = 0;
+    std::int64_t last_wheel_end_ = 0;
+    std::uint64_t block_ = 0;
+    Result window_;
+    bool endpoint(std::int64_t time_ns, Endpoint &result) const;
+    void process();
+    void emit(const Result &result);
+    void accumulate(const Result &result);
+};
+
+} // namespace omni
diff --git a/localization/src/primary_yaw_timeline.cpp b/localization/src/primary_yaw_timeline.cpp
new file mode 100644
index 0000000..3897939
--- /dev/null
+++ b/localization/src/primary_yaw_timeline.cpp
@@ -0,0 +1,138 @@
+#include "primary_yaw_timeline.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace omni {
+namespace {
+bool next_id(std::uint32_t value, std::uint32_t previous) {
+    const std::uint32_t step = value - previous;
+    return step > 0 && step < 0x80000000u;
+}
+std::int64_t subtract_saturated(std::int64_t value, std::int64_t offset) {
+    if (offset > 0 && value < std::numeric_limits<std::int64_t>::min() + offset)
+        return std::numeric_limits<std::int64_t>::min();
+    if (offset < 0 && value > std::numeric_limits<std::int64_t>::max() + offset)
+        return std::numeric_limits<std::int64_t>::max();
+    return value - offset;
+}
+} // namespace
+
+PrimaryYawTimeline::PrimaryYawTimeline() : PrimaryYawTimeline(Config{}) {}
+PrimaryYawTimeline::PrimaryYawTimeline(Config configuration) : configuration_(configuration) {
+    if (configuration_.capacity < 2) throw std::invalid_argument("yaw timeline capacity must be at least two");
+}
+
+void PrimaryYawTimeline::reset() {
+    yaws_.clear(); rates_.clear(); have_yaw_id_ = false; have_rate_id_ = false;
+}
+
+bool PrimaryYawTimeline::ingest_rate(const RateSample &sample) {
+    if ((sample.usable && !std::isfinite(sample.omega_rad_s)) ||
+        (have_rate_id_ && !next_id(sample.source_id, last_rate_id_))) return false;
+    have_rate_id_ = true; last_rate_id_ = sample.source_id;
+    if (rates_.size() == configuration_.capacity) rates_.pop_front();
+    rates_.push_back(sample);
+    // A rate-only arrival never revises the prediction of an older yaw. The
+    // next genuine yaw event may use this actual derivative if already received.
+    return true;
+}
+
+bool PrimaryYawTimeline::ingest_yaw(const YawSample &sample) {
+    if (!std::isfinite(sample.angle_rad) || (have_yaw_id_ && !next_id(sample.source_id, last_yaw_id_))) return false;
+    Node node;
+    node.raw = sample;
+    node.physical_estimate_ns = subtract_saturated(sample.event_ns, configuration_.phase_ns);
+    node.prediction_until_ns = node.physical_estimate_ns;
+    node.prediction_angle_rad = sample.angle_rad;
+    const auto target = configuration_.prediction_endpoint == PredictionEndpoint::ReceiveEvent ? sample.receive_ns : sample.event_ns;
+    for (auto rate = rates_.rbegin(); rate != rates_.rend(); ++rate) {
+        // This is causality, not an age/quality condition: a future-received
+        // sample cannot be borrowed when replaying an earlier yaw arrival.
+        if (rate->receive_ns > sample.receive_ns) continue;
+        // An explicit newest unusable derivative ends the older derivative's
+        // eligibility for this new yaw. It does not modify any prior yaw node.
+        if (!rate->usable) break;
+        if (target > node.physical_estimate_ns) {
+            const double duration_s = (static_cast<double>(target) - static_cast<double>(node.physical_estimate_ns)) / 1e9;
+            const double predicted = sample.angle_rad + rate->omega_rad_s * duration_s;
+            if (std::isfinite(predicted)) {
+                node.rate = *rate; node.uses_rate = true;
+                node.prediction_until_ns = target; node.prediction_angle_rad = predicted;
+            }
+        }
+        break;
+    }
+    have_yaw_id_ = true; last_yaw_id_ = sample.source_id;
+    // Preserve valid new source events even if a clock mapping adjustment moved
+    // their estimated host time backwards. Ordering is for interpolation only.
+    auto where = std::lower_bound(yaws_.begin(), yaws_.end(), node.physical_estimate_ns,
+        [](const Node &row, std::int64_t t) { return row.physical_estimate_ns < t; });
+    if (where != yaws_.end() && where->physical_estimate_ns == node.physical_estimate_ns) *where = node;
+    else yaws_.insert(where, node);
+    if (yaws_.size() > configuration_.capacity) yaws_.pop_front();
+    return true;
+}
+
+PrimaryYawTimeline::Estimate PrimaryYawTimeline::query(std::int64_t time_ns) const {
+    Estimate result;
+    result.query_ns = time_ns; result.phase_ns = configuration_.phase_ns;
+    if (yaws_.empty()) return result;
+    result.available = true;
+    const auto &last = yaws_.back();
+    result.measured_until_ns = last.physical_estimate_ns;
+    result.prediction_until_ns = last.prediction_until_ns;
+    auto right = std::lower_bound(yaws_.begin(), yaws_.end(), time_ns,
+        [](const Node &row, std::int64_t t) { return row.physical_estimate_ns < t; });
+    if (right != yaws_.end() && right->physical_estimate_ns == time_ns) {
+        result.angle_rad = right->raw.angle_rad; result.left_yaw = right->raw;
+        result.support = Support::MeasuredHistory;
+    } else if (right == yaws_.begin()) {
+        result.angle_rad = right->raw.angle_rad; result.left_yaw = right->raw;
+        result.support = Support::EndpointHold;
+    } else if (right != yaws_.end()) {
+        const auto &left = *(right - 1);
+        const double f = (static_cast<double>(time_ns) - static_cast<double>(left.physical_estimate_ns)) /
+            (static_cast<double>(right->physical_estimate_ns) - static_cast<double>(left.physical_estimate_ns));
+        result.angle_rad = left.raw.angle_rad * (1. - f) + right->raw.angle_rad * f;
+        result.left_yaw = left.raw; result.right_yaw = right->raw; result.has_right_yaw = true;
+        result.support = Support::MeasuredHistory;
+    } else {
+        result.left_yaw = last.raw; result.uses_rate = last.uses_rate; result.rate = last.rate;
+        if (last.uses_rate && time_ns <= last.prediction_until_ns) {
+            const double duration_s = (static_cast<double>(time_ns) - static_cast<double>(last.physical_estimate_ns)) / 1e9;
+            result.angle_rad = last.raw.angle_rad + last.rate.omega_rad_s * duration_s;
+            result.support = Support::FinitePrediction;
+        } else {
+            result.angle_rad = last.prediction_angle_rad;
+            result.support = Support::EndpointHold;
+        }
+    }
+    return result;
+}
+
+std::vector<PrimaryYawTimeline::HistoryRow> PrimaryYawTimeline::export_history() const {
+    std::vector<HistoryRow> result;
+    result.reserve(yaws_.size() + 1);
+    for (const auto &node : yaws_) {
+        HistoryRow row;
+        row.time_ns = node.physical_estimate_ns; row.angle_rad = node.raw.angle_rad;
+        row.source_yaw_id = node.raw.source_id; row.support = Support::MeasuredHistory;
+        result.push_back(row);
+    }
+    if (!yaws_.empty()) {
+        const auto &last = yaws_.back();
+        if (last.uses_rate && last.prediction_until_ns > last.physical_estimate_ns) {
+            HistoryRow row;
+            row.time_ns = last.prediction_until_ns; row.angle_rad = last.prediction_angle_rad;
+            row.support = Support::FinitePrediction; row.source_yaw_id = last.raw.source_id;
+            row.has_rate = true; row.rate_source_id = last.rate.source_id;
+            result.push_back(row);
+        }
+    }
+    return result;
+}
+
+} // namespace omni
