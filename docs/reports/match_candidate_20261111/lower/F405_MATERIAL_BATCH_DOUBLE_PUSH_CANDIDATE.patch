+/* Bulk delivery only. The first push already completed through ENTER.
+ * Reuse the existing S1 exit order (55, reverse,86) and its servo travel
+ * estimate, not a new fixed delay or feedback qualification. No state15 is
+ * published until both pushes and raised retreats have actually progressed
+ * through this local mechanical state machine. */
+static void task_process_material_double_push(uint32_t now_ms)
+{
+  if (delivery_exit_phase == 0U) {
+    Motor_Stop();
+    task_status.motors_active = false;
+    if (Claw_Open(now_ms)) {
+      task_status.gripper_closed = false;
+      Camera_SetAngle(APP_DELIVERY_CAMERA_ANGLE);
+      camera_angle = (float)APP_DELIVERY_CAMERA_ANGLE;
+      step_started_ms = now_ms;
+      delivery_exit_phase_ready_ms = now_ms + Lift_PositionWaitMs(APP_LIFT_START_ANGLE);
+      Lift_SetStartPosition();
+      delivery_exit_phase = 1U;
+    }
+    return;
+  }
+  if (delivery_exit_phase == 1U || delivery_exit_phase == 3U ||
+      delivery_exit_phase == 5U) {
+    Motor_Stop();
+    task_status.motors_active = false;
+    if ((int32_t)(now_ms - delivery_exit_phase_ready_ms) >= 0) {
+      ++delivery_exit_phase;
+      delivery_exit_path_valid = false;
+    }
+    return;
+  }
+  if (delivery_exit_phase == 2U || delivery_exit_phase == 4U ||
+      delivery_exit_phase == 6U) {
+    LocationPose pose;
+    if (!task_get_location_pose(&pose, now_ms)) { return; }
+    if (!delivery_exit_path_valid) {
+      delivery_exit_start_path_mm = pose.path_mm;
+      delivery_exit_path_valid = true;
+    }
+    const uint32_t target_mm =
+        (uint32_t)(APP_DELIVERY_EXIT_DISTANCE_M * 1000.0f + 0.5f);
+    const uint32_t used = pose.path_mm - delivery_exit_start_path_mm;
+    MotorDistanceStatus result = MOTOR_DISTANCE_DONE;
+    if (used < target_mm) {
+      const bool second_push = delivery_exit_phase == 4U;
+      const float distance_m = (float)(target_mm - used) * 0.001f;
+      result = Motor_MoveDistanceHeading(second_push ? distance_m : -distance_m,
+          second_push ? APP_SAFE_FINAL_PUSH_SPEED_MM_S : APP_DELIVERY_EXIT_SPEED_MM_S,
+          delivery_push_heading_deg);
+    }
+    task_status.motors_active = result == MOTOR_DISTANCE_RUNNING;
+    if (result == MOTOR_DISTANCE_DONE) {
+      Motor_Stop();
+      task_status.motors_active = false;
+      if (delivery_exit_phase == 6U) {
+        delivery_double_push_done = true;
+        task_enter(TASK_RAM_VERIFY, now_ms);
+      } else {
+        const bool lower_for_second_push = delivery_exit_phase == 2U;
+        delivery_exit_phase_ready_ms = now_ms + Lift_PositionWaitMs(
+            lower_for_second_push ? APP_LIFT_TRAVEL_ANGLE : APP_LIFT_START_ANGLE);
+        if (lower_for_second_push) { Lift_SetTravelPosition(); }
+        else { Lift_SetStartPosition(); }
+        ++delivery_exit_phase;
+      }
+    } else if (distance_failed(result)) {
+      task_stop(TASK_FAULT_MOTOR, now_ms);
+    }
+    return;
+  }
+}
