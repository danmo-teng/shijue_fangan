+/* Net turn, rather than sum(abs(delta)): left/right corrections are not a
+ * complete physical revolution. Only a new CLEAR business resets this;
+ * HOLD and mode43 retries cannot restart the search angle budget.
+ * It is an angle budget, not a guarantee of camera coverage or visibility. */
+static bool task_sweep_search_circle_reached(const LocationPose *pose)
+{
+  if (sweep_search_heading_valid) {
+    int32_t delta = pose->heading_mdeg - sweep_search_last_heading_mdeg;
+    if (delta > 180000) { delta -= 360000; }
+    else if (delta < -180000) { delta += 360000; }
+    sweep_search_net_turn_mdeg += delta;
+  } else {
+    sweep_search_heading_valid = true;
+  }
+  sweep_search_last_heading_mdeg = pose->heading_mdeg;
+  return sweep_search_net_turn_mdeg >= (int64_t)APP_SEARCH_FULL_TURN_MDEG ||
+         sweep_search_net_turn_mdeg <= -(int64_t)APP_SEARCH_FULL_TURN_MDEG;
+}
